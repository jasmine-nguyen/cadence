# Copy to .env (gitignored), then run `chmod 600 .env` and fill in.
# Read by backend/secrets.py get_secrets() when CADENCE_AWS_SECRET_ID isn't set.
# The AWS secret (cadence/prod) uses these same key names.
COROS_EMAIL=
COROS_PASSWORD=
COROS_REGION=us
# The Claude key is CLAUDE_API_KEY. Never name it ANTHROPIC_API_KEY.
CLAUDE_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# SPEEDIANCE_* (pending ADR-007)
# SPEEDIANCE_EMAIL=
# SPEEDIANCE_PASSWORD=
# SPEEDIANCE_REGION=
# SPEEDIANCE_DEVICE_TYPE=
